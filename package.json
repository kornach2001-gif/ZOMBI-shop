{
  "name": "zombishop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://zombishop.loca.lt",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host",
    "serve": "npm run build && npx --yes serve -s dist -l 4173",
    "tunnel": "npx --yes localtunnel --port 4173 --subdomain zombishop"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
